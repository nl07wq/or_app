{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "or-app-notifications",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-23",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      { "name": "PROFILES", "class_name": "NotificationProfile" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["NotificationProfile"] }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "https://nl07wq.github.io",
    "VAPID_SUBJECT": "https://nl07wq.github.io/or_app/"
  }
}
